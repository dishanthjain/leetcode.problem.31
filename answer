class Solution {
public:
    void nextPermutation(vector<int>& nums) {
        int i = nums.size() - 2;

        while (i >= 0 && nums[i] >= nums[i + 1])
            i--;

        if (i >= 0) {
            int j = nums.size() - 1;

            while (nums[j] <= nums[i])
                j--;

            swap(nums[i], nums[j]);
        }

        reverse(nums.begin() + i + 1, nums.end());
    }
};

Explaination:

Find the first number from the right that can be increased, swap it with the next larger number, then reverse the remaining part to get the smallest possible next permutation.
